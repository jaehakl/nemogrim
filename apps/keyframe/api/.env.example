# Keyframe API 설정. 모든 값은 선택 사항이며 아래는 기본값이다.

# AI 실행 장치: auto(CUDA 있으면 GPU) | cuda | cpu
# KEYFRAME_AI_DEVICE=auto

# 모델 파일 캐시 위치 (기본: apps/keyframe/data/models)
# KEYFRAME_AI_MODEL_CACHE_DIR=

# 기동 직후 백그라운드에서 모델을 미리 로드할지 여부 (--reload 개발 중에는 false 권장)
# KEYFRAME_AI_WARMUP=false

# true면 이미 내려받은 모델만 사용하고 네트워크 다운로드를 하지 않는다.
# KEYFRAME_AI_OFFLINE=false

# 텍스트 검색 요청이 AI 응답을 기다리는 최대 시간(초)
# KEYFRAME_AI_REQUEST_TIMEOUT_SECONDS=180

# WD14 태그 선택 기준
# KEYFRAME_WD14_GENERAL_THRESHOLD=0.35
# KEYFRAME_WD14_CHARACTER_THRESHOLD=0.85
# KEYFRAME_WD14_MAX_TAGS=64

# API를 직접 호출할 수 있는 브라우저 origin (JSON 배열)
# KEYFRAME_CORS_ORIGINS=["http://127.0.0.1:5175","http://localhost:5175"]
